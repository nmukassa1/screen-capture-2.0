{
  "manifest_version": 3,
  "name": "Designspo Extension",
  "version": "1.6",
  "description": "Takes a screenshot of the current tab",
  "key": "",
  "permissions": ["activeTab", "scripting", "tabs", "storage"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "/icon-16.png",
    "32": "/icon-32.png",
    "48": "/icon-48.png",
    "128": "/icon-128.png"
  },
  "action": {
    "default_popup": "index.html"
  },
  "externally_connectable": {
    "matches": [
      "https://designspo-webpage.vercel.app/*",
      "https://app.designspo.com/*",
      "http://localhost/*"
    ]
  },
  "host_permissions": [
    "https://*.supabase.co/*",
    "https://screen-capture-2-0.vercel.app/*",
    "http://localhost:4000/*"
  ]
}
