{
  "manifest_version": 3,
  "name": "Screenshot Extension",
  "version": "1.0",
  "description": "Takes a screenshot of the current tab",
  "permissions": ["activeTab", "scripting", "tabs", "storage", "cookies"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "index.html"
  },
  "host_permissions": [
    "<all_urls>",
    "http://*/*",
    "https://*/*",
    "https://*.supabase.co/*",
    "http://localhost:5173/*"
  ]
}
