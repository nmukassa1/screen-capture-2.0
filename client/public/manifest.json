{
  "manifest_version": 3,
  "name": "Designspo Extension",
  "version": "1.0",
  "description": "Takes a screenshot of the current tab",
  "permissions": ["activeTab", "scripting", "tabs", "storage", "cookies"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": [
    "./icon-16.png",
    "./icon-32.png",
    "./icon-48.png",
    "./icon-128.png"
  ],
  "action": {
    "default_popup": "index.html"
  },
  "host_permissions": ["https://*.supabase.co/*"]
}
