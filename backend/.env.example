# ---------------------------------------------------------------------------
# Prisma → Supabase Postgres (direct connection)
# ---------------------------------------------------------------------------
# Dashboard → Project Settings → Database → Connection string → URI → Direct connection.
# Host must be db.<project-ref>.supabase.co on port 5432 (not *.pooler.supabase.com).
# ---------------------------------------------------------------------------
DATABASE_URL=""

# Anon / public key (Dashboard → Project Settings → API → Project API keys → anon public)
SUPABASE_KEY=""

# Service role — required only for admin routes such as DELETE /auth/delete-account/:id
# Never expose this in the browser or client apps.
SUPABASE_SERVICE_ROLE_KEY=""

SUPABASE_URL=''

SUPABASE_JWT_SECRET=''

# Comma-separated extra origins (optional). Defaults include https://app.designspo.com
# and http://localhost:3000.
CORS_ORIGINS=""

# Chrome extension ID (chrome://extensions). Only chrome-extension://<EXTENSION_ID> is allowed
# by CORS. Comma-separate to allow several (e.g. unpacked dev build + Web Store build).
EXTENSION_ID=""