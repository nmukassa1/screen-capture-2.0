{
  "compilerOptions": {
    "target": "es6",
    "module": "CommonJS",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "types": [
      "node",
      "express",
      "zod",
      "cookie-parser",
      "jsonwebtoken",
      "@prisma/client",
      "@supabase/supabase-js"
    ],
    "typeRoots": ["node_modules/@types"],
    "skipLibCheck": true,
    "moduleResolution": "node"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
