// Prisma + Supabase Postgres: https://supabase.com/docs/guides/database/prisma
generator client {
  provider = "prisma-client-js"
}


datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Screenshot {
  id          Int                   @id @default(autoincrement())
  img         String
  siteName    String
  siteUrl     String
  userId      String                @db.Uuid
  createdAt   DateTime              @default(now())
  tags        ScreenshotTag[]
  description ScreenshotDescription?
}

model ScreenshotDescription {
  id           Int        @id @default(autoincrement())
  content      String
  screenshot   Screenshot @relation(fields: [screenshotId], references: [id], onDelete: Cascade)
  screenshotId Int        @unique // enforce 1-to-1 relationship
}

model Tag {
  id     Int     @id @default(autoincrement())
  name   String
  userId String  @db.Uuid // Store the Supabase Auth User ID
  createdAt DateTime @default(now()) 
  screenshots ScreenshotTag[]
}

model ScreenshotTag {
  screenshotId Int
  tagId        Int
  screenshot   Screenshot @relation(fields: [screenshotId], references: [id], onDelete: Cascade)
  tag          Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([screenshotId, tagId]) // Composite primary key
}

model WaitingList {
 id Int @id @default(autoincrement())
 email String
 created_at DateTime @default(now()) 

}